{
  "name": "enviroweather-fleet",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Enviroweather station diagnostics and fieldwork workspace.",
  "scripts": {
    "serve": "python3 -m http.server 8130 --bind 127.0.0.1 --directory web",
    "vercel-build": "node scripts/prepare-vercel-output.js",
    "check": "node scripts/check-syntax.mjs",
    "build": "npm run check && npm test",
    "test": "node --test backend/tests/*.test.mjs",
    "fleet:test": "node --test backend/tests/*.test.mjs",
    "fleet:deploy": "npm --prefix backend run deploy"
  },
  "keywords": [
    "enviroweather",
    "station-diagnostics",
    "field-notes"
  ],
  "license": "UNLICENSED"
}
